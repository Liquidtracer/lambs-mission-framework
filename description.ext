/*
	Mission configuration
	Description.ext handles all sorts of framework important settings.
*/

// Header
class Header
{
	gameType = Coop;
	minPlayers = 1;
	maxPlayers = 99;
};

// Respawn
respawn = 3;
respawnDelay = 30;
respawnDialog = 0;
respawnOnStart = -1;
respawnTemplates[] = {"counter"};

// Miscellaneous
debriefing = 0;
allowProfileGlasses = 0;
briefing = 0;
disabledai = 1;
// enableDebugConsole = 1;
enableDebugConsole[] = {
	"76561197962792796", // nkenny
	"76561197972498138", // Liquid Tracer
	"76561197968829665"  // Alex2k
};
enableTargetDebug = 1;
disableChannels[]={0, 2, 4, 5};
cba_settings_hasSettingsFile = 1;
forceRotorLibSimulation = 2;
// disableRandomization[] = { "All" };

// Corpses
corpseManagerMode = 1;
corpseLimit = 20;
corpseRemovalMinTime = 180;
corpseRemovalMaxTime = 600;

// Weapon holders
weaponholderManagerMode = 1;
weaponholderLimit = 20;
weaponholderRemovalMinTime = 180;
weaponholderRemovalMaxTime = 600;

// Wrecks
wreckManagerMode = 1;
wreckLimit = 10;
wreckRemovalMinTime = 300;
wreckRemovalMaxTime = 1200;

minPlayerDistance[] = {50, 300, 50, 1200, 1200, 1200};


// --- Functions -------------------------------------------------------------------------------
class CfgFunctions {
	createShortcuts = 1;
	#include "framework\functions.hpp"
};

// Pre-init EHs
class Extended_PreInit_EventHandlers {
	class lambs_preInit {
		Init = "[] call compile preprocessFileLineNumbers 'framework\XEH_preInit.sqf'";
	};
};

// Post-init EHs
class Extended_PostInit_EventHandlers {
	class lambs_postInit {
		init = "[] call compile preprocessFileLineNumbers 'framework\XEH_postInit.sqf'";
	};
};

// Init-post EHs
class Extended_InitPost_EventHandlers {
	class Air {
		init = "_this call lmf_objectSorting_fnc_sortAirVehicles;";
	};
	class LandVehicle {
		init = "_this call lmf_objectSorting_fnc_sortGroundVehicles;";
	};
	class CAManBase {
		init = "_this call lmf_objectSorting_fnc_sortUnits;";
	};
	class ReammoBox_F {
		init = "_this call lmf_objectSorting_fnc_sortSupplyCrates;";
	};
	class Ship {
		init = "_this call lmf_objectSorting_fnc_sortWaterVehicles;";
	};
};

// Debriefing
class CfgDebriefingSections {
	class acex_killTracker {
		title = "Acex Killed Events";
		variable = "acex_killTracker_outputText";
	};
};

// Notifications
#include "framework\notifications\CfgNotifications.hpp"
